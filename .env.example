# Google Analytics 4 measurement ID for this site.
#
# Leave it unset and the site emits no analytics code at all — that is the
# correct state for a fork or a local build, so nobody's traffic lands in
# someone else's property by accident.
#
# In CI this comes from the repository variable GA_MEASUREMENT_ID, not from a
# secret: a measurement ID is public by nature (it ships in the page), and
# storing it as a secret would only make it harder to see what is deployed.
#
# Use a property of its own. Pointing this at the corporate site's property
# mixes documentation traffic with marketing traffic and makes both harder to
# read.
PUBLIC_GA_MEASUREMENT_ID=

# Set to "false" to drop the consent bar.
#
# The site is lawful either way: Consent Mode starts denied, so no cookie is
# written until a visitor opts in, and GA4 still counts pages cookielessly.
# The bar exists so visitors who are willing can also be counted as returning
# visitors rather than as a new one each time.
PUBLIC_ANALYTICS_CONSENT_BANNER=true
